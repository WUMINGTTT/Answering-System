// ============================================================================
// tsconfig.json —— TypeScript 编译器的主配置文件
// ============================================================================
// 【技术学习】tsconfig.json 是 TypeScript 项目的根配置文件。
// 它告诉 TypeScript 编译器（tsc）：
//   - 如何编译项目中的 .ts / .vue 文件
//   - 使用哪些编译选项（严格检查、模块系统、目标环境等）
//   - 包含和排除哪些文件
//
// 当你在命令行运行 tsc 或 vue-tsc 时，编译器会自动查找并读取此文件。
// ============================================================================

{
  // 【技术学习】files 设置为空数组，表示此配置文件本身不直接编译任何文件
  // 所有实际的编译工作都委托给下面的 references（项目引用）
  "files": [],

  // 【技术学习】项目引用（Project References）—— TypeScript 3.0+ 引入的重要特性
  //
  // 作用：
  //   1. 将一个大型 TypeScript 项目拆分为多个子项目（子配置）
  //   2. 每个子项目有独立的编译选项，互不干扰
  //   3. 支持增量编译 —— 只重新编译发生变化的子项目，大幅提升编译速度
  //   4. 明确子项目之间的依赖关系
  //
  // 本项目分为两个子配置：
  //   - tsconfig.node.json：用于 Node.js 环境的配置文件（如 vite.config.ts）
  //   - tsconfig.app.json：用于浏览器环境的应用源代码（src/ 目录）
  //
  // 【技术学习】为什么需要分开？
  //   - Node.js 环境和浏览器环境有不同的全局 API 和模块解析方式
  //   - 分开配置可以让 TypeScript 对不同环境提供正确的类型检查
  //   - 例如：Node.js 有 process、Buffer，浏览器有 document、window
  "references": [
    // 子项目 1：Node.js 环境配置
    // 包含 vite.config.ts 等在 Node.js 中运行的配置文件
    {
      "path": "./tsconfig.node.json"
    },
    // 子项目 2：浏览器环境配置
    // 包含 src/ 目录下的所有应用源代码（.ts、.vue 文件）
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
